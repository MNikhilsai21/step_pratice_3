class IdCard {
    String name;
    int booksIssued;

    public IdCard(String name, int booksIssued) {
        this.name = name;
        this.booksIssued = booksIssued;
    }

    public static void main(String[] args) {
        IdCard ravi = new IdCard("Ravi", 0);
        
        // Pointing a second variable to the exact same object reference
        IdCard duplicate = ravi; 
        duplicate.booksIssued = 3; // Modifying through the duplicate reference

        // Proving object mutation and identity checks
        System.out.println("Ravi's booksIssued (via first variable): " + ravi.booksIssued);
        System.out.println("duplicate == ravi: " + (duplicate == ravi));
        
        // Creating a structurally identical but distinct new object reference
        IdCard separate = new IdCard("Ravi", 3);
        System.out.println("separate == ravi: " + (separate == ravi));
    }
}
