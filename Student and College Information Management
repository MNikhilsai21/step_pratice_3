class Student {
    String name;
    int attendance;
    
    // Shared static variables across all instances
    static String collegeName = "SRM Institute of Science and Technology";
    static int studentCount = 0;

    public Student(String name, int attendance) {
        this.name = name;
        this.attendance = attendance;
        studentCount++; // Increments statically every time a student is instantiated
    }

    // Static method: can only touch static variables, not instance fields
    static void printCollegeInfo() {
        System.out.println(collegeName);
        System.out.println("Students created: " + studentCount);
    }

    public static void main(String[] args) {
        Student s1 = new Student("Amit", 85);
        Student s2 = new Student("Sneha", 92);

        // Called directly through the class name, not instances
        Student.printCollegeInfo(); 
    }
}
