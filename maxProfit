public int maxProfit(int[] prices) {
    if (prices == null || prices.length == 0) {
        return 0;
    }
    
    int minPrice = prices[0]; // Track the lowest buying price seen so far
    int maxProfit = 0;        // Track the running maximum profit
    
    // Single-pass traversal through the daily prices
    for (int i = 1; i < prices.length; i++) {
        if (prices[i] < minPrice) {
            minPrice = prices[i]; // Update running minimum
        } else {
            int currentProfit = prices[i] - minPrice; // Work out profit if sold today
            if (currentProfit > maxProfit) {
                maxProfit = currentProfit; // Update max profit
            }
        }
    }
    return maxProfit;
}
