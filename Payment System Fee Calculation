import sys

# Base Class / Interface representing the common payment abstraction
class PaymentMethod:
    def calculate_final_amount(self, amount: float) -> float:
        raise NotImplementedError

# Specialized implementations detailing specific fee behaviors
class CardPayment(PaymentMethod):
    def calculate_final_amount(self, amount: float) -> float:
        return amount * 1.02  # 2% fee added

class WalletPayment(PaymentMethod):
    def calculate_final_amount(self, amount: float) -> float:
        return amount * 1.01  # 1% fee added

class BankTransferPayment(PaymentMethod):
    def calculate_final_amount(self, amount: float) -> float:
        return amount  # No fee

# Simple Factory to safely instantiate types uniformly
def payment_factory(payment_type: str) -> PaymentMethod:
    mapping = {
        "CARD": CardPayment,
        "WALLET": WalletPayment,
        "BANKTRANSFER": BankTransferPayment
    }
    return mapping[payment_type]()

def solve_payment_system():
    input_data = sys.stdin.read().splitlines()
    if not input_data:
        return
    
    n = int(input_data[0].strip())
    grand_total = 0.0
    
    for i in range(1, n + 1):
        parts = input_data[i].split()
        pay_type = parts[0].strip()
        amount = float(parts[1].strip())
        
        processor = payment_factory(pay_type)
        adjusted_amount = processor.calculate_final_amount(amount)
        grand_total += adjusted_amount
        
        print(f"{pay_type}: {adjusted_amount:.2f}")
        
    print(f"Total: {grand_total:.2f}")

if __name__ == "__main__":
    solve_payment_system()
